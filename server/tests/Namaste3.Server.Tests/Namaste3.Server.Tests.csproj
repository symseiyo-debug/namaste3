<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>12</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- FR : versions ÉPINGLÉES sur celles du cache NuGet local, comme l'étage 2 — un seul cache
            sert les deux projets et le restore reste hors-ligne.
       EN : versions PINNED to the local NuGet cache, like stage 2 — one cache serves both
            projects and restore stays offline. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Namaste3.Server.Connection/Namaste3.Server.Connection.csproj" />
  </ItemGroup>

</Project>
